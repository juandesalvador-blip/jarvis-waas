# =============================================================================
# JARVIS – Variables de entorno
# Copia este archivo a ".env" y ajusta los valores antes de levantar la stack.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/Mac:             cp .env.example .env
# =============================================================================

# --- General ---------------------------------------------------------------
TZ=America/Bogota

# =============================================================================
# NÚCLEO COMPACTO (siempre activo)
# =============================================================================

# --- Ollama ---------------------------------------------------------------
OLLAMA_PORT=11434
# Modelos a descargar automáticamente al iniciar (separados por coma).
# qwen2.5:3b es el modelo por defecto del asistente: buen balance para
# CPU sin GPU. Agrega modelos más grandes (ej. qwen2.5:7b) solo si tu
# hardware los soporta con velocidad aceptable.
OLLAMA_MODELS=qwen2.5:3b

# --- Asistente General (CrewAI + SQLite, un solo agente) --------------------
ASSISTANT_PORT=8600
OLLAMA_ASSISTANT_MODEL=qwen2.5:3b

# --- Streamlit UI (habla directo con el asistente) --------------------------
STREAMLIT_PORT=8501
ASSISTANT_URL=http://jarvis-assistant:8000/assist

# =============================================================================
# EXTRAS (profile "extras" — solo se usan si los activas explícitamente)
#   docker compose --profile extras up -d
#   python scripts/jarvis_manager.py up --all
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jarvis
POSTGRES_PORT=5432

# --- Neo4j -------------------------------------------------------------------
NEO4J_PASSWORD=changeme123
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Redis ---------------------------------------------------------------
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# --- MinIO ---------------------------------------------------------------
MINIO_ROOT_USER=jarvis_admin
MINIO_ROOT_PASSWORD=changeme123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- n8n ---------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
N8N_ENCRYPTION_KEY=please-change-this-key
N8N_WEBHOOK_URL=http://localhost:5678/webhook/jarvis-chat

# --- Prometheus / Grafana ---------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
