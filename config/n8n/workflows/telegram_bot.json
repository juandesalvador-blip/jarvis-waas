{
  "name": "Jarvis - Canal Telegram",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "2f3a1b10-0000-4000-8000-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [-320, 0],
      "webhookId": "jarvis-telegram",
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.JARVIS_ASSISTANT_URL || 'http://jarvis-assistant:8000/assist' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"message\": $json.message.text, \"user_id\": 'telegram-' + $json.message.chat.id, \"language\": \"es\" } }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "2f3a1b10-0000-4000-8000-000000000002",
      "name": "Llamar Asistente General",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-80, 0]
    },
    {
      "parameters": {
        "chatId": "={{ $node[\"Telegram Trigger\"].json.message.chat.id }}",
        "text": "={{ $json.response_text }}",
        "additionalFields": {}
      },
      "id": "2f3a1b10-0000-4000-8000-000000000003",
      "name": "Responder en Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [160, 0],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Llamar Asistente General",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Llamar Asistente General": {
      "main": [
        [
          {
            "node": "Responder en Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
